# Password for the control panel. Required on Vercel; without it the panel stays locked.
PANEL_PASSWORD=

# Signs the mock sign-in tokens and the panel cookie. Any long random string.
TOKEN_SECRET=

# Set automatically when you connect an Upstash Redis store from the Vercel Marketplace.
# Without them, Dummy School keeps its state in memory (fine locally, lost between requests on Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=
